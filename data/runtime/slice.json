      "id": "first_blood_before",
      "entry": "opening",
      "nodes": [
        {
          "id": "opening",
          "speaker": "narrator",
          "text": "Die Gasse verengt sich. Eine blanke Klinge versperrt den Weg."
        }
      ]
    },
    {
      "id": "first_blood_victory",
      "entry": "opening",
      "nodes": [
        {
          "id": "opening",
          "speaker": "narrator",
          "text": "Das Messer fällt auf den Stein. Hinter den Dächern wartet die Heerstraße."
        }
      ]
    },
    {
      "id": "deserters_toll_before",
      "entry": "opening",
      "nodes": [
        {
          "id": "opening",
          "speaker": "Deserteur",
          "text": "Die Nordwacht schützt hier niemanden mehr. Den Wegzoll nehme jetzt ich."
        }
      ]
    },
    {
      "id": "deserters_toll_victory",
      "entry": "opening",
      "nodes": [
        {
          "id": "opening",
          "speaker": "narrator",
          "text": "Der Schild sinkt. Zwischen den Hecken führt eine Spur zur alten Wacht."
        }
      ]
    },
    {
      "id": "cult_in_the_hedges_before",
      "entry": "opening",
      "nodes": [
        {
          "id": "opening",
          "speaker": "narrator",
          "text": "Ein Flüstern steigt aus der Lichtung. Im Schatten wartet eine zweite Klinge."
        }
      ]
    },
    {
      "id": "cult_in_the_hedges_victory",
      "entry": "opening",
      "nodes": [
        {
          "id": "opening",
          "speaker": "narrator",
          "text": "Das Flüstern verstummt. Über den Hecken erhebt sich das Tor der Nordwacht."
        }
      ]
    },
    {
      "id": "gate_of_the_north_watch_before",
      "entry": "opening",
      "nodes": [
        {
          "id": "opening",
          "speaker": "Eiserner Hauptmann",
          "text": "Solange ich stehe, bleibt dieses Tor geschlossen.",
          "next": "resolve"
        },
        {
          "id": "resolve",
          "speaker": "narrator",
          "text": "Der Hauptmann hebt seinen Schild. Die letzte Formation hält."
        }
      ]
    },
    {
      "id": "gate_of_the_north_watch_victory",
      "entry": "opening",
      "nodes": [
        {
          "id": "opening",
          "speaker": "narrator",
          "text": "Der große Schild liegt still. Das Tor ist offen; der Weg durch die Nordwacht beginnt."
        }
      ]
    }
  ]
