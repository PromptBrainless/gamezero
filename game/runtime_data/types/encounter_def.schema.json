{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "encounter_def.schema.json",
  "title": "encounter_def",
  "description": "Playable fight composed of ordered waves on a stage. A slice encounter maps to one `encounter_start` wave whose spawns are its `enemies`, with `stage` = former `arena`. See docs/final-data-entities/enemies-and-encounters.md.",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "difficulty",
    "stage",
    "waves",
    "victory",
    "rewards",
    "description"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "name": { "$ref": "common.schema.json#/$defs/text" },
    "type": { "enum": ["tutorial", "standard", "boss"] },
    "order": { "type": "integer", "minimum": 1 },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "stage": { "$ref": "common.schema.json#/$defs/id" },
    "waves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "trigger", "spawns"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "trigger": { "enum": ["encounter_start", "previous_wave_cleared"] },
          "spawns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind", "actor", "slot"],
              "additionalProperties": false,
              "properties": {
                "kind": { "enum": ["enemy", "boss"] },
                "actor": { "$ref": "common.schema.json#/$defs/id" },
                "slot": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "victory": { "enum": ["defeat_all_waves", "defeat_boss"] },
    "rewards": { "$ref": "common.schema.json#/$defs/rewards" },
    "description": { "$ref": "common.schema.json#/$defs/text" }
  }
}
