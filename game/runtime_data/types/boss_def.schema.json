{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boss_def.schema.json",
  "title": "boss_def",
  "description": "Boss with ordered HP-threshold phases and telegraphs. Strict superset of the canonical slice `bosses` record; adds family. See docs/final-data-entities/enemies-and-encounters.md.",
  "type": "object",
  "required": ["id", "name", "title", "family", "tier", "base_stats", "phases", "description"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "name": { "$ref": "common.schema.json#/$defs/text" },
    "title": { "$ref": "common.schema.json#/$defs/text" },
    "family": { "$ref": "common.schema.json#/$defs/id" },
    "tier": { "type": "integer", "minimum": 1 },
    "base_stats": { "$ref": "common.schema.json#/$defs/base_stats" },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "hp_threshold", "skills"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "name": { "$ref": "common.schema.json#/$defs/text" },
          "hp_threshold": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "skills": {
            "allOf": [{ "$ref": "common.schema.json#/$defs/id_list" }, { "minItems": 1 }]
          },
          "telegraphs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["skill", "warning_turns", "icon"],
              "additionalProperties": false,
              "properties": {
                "skill": { "$ref": "common.schema.json#/$defs/id" },
                "warning_turns": { "type": "integer", "minimum": 1 },
                "icon": { "$ref": "common.schema.json#/$defs/id" }
              }
            }
          },
          "on_enter": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "apply_status": { "$ref": "common.schema.json#/$defs/id" },
                "duration": { "type": "integer", "minimum": 1 },
                "target": { "enum": ["self", "enemy"] },
                "stat_modifier": { "$ref": "common.schema.json#/$defs/stat_delta" }
              }
            }
          }
        }
      }
    },
    "loot_table": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/loot_entry" }
    },
    "xp_reward": { "type": "integer", "minimum": 0 },
    "description": { "$ref": "common.schema.json#/$defs/text" },
    "visual": { "$ref": "common.schema.json#/$defs/visual" }
  }
}
