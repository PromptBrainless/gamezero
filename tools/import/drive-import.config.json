{
  "$comment": "GameZero Drive import configuration. Paths are relative to the repository root unless they start with ~ or /. This file contains no secrets; credentials live in tools/import/.secrets/ (git-ignored) or ~/.config/gamezero/. See tools/import/README.md.",
  "source": {
    "folder": "https://drive.google.com/drive/folders/1J7Ww5YBFyOVMgirT0AXXY_o2YVgH4jRv",
    "followShortcuts": true
  },
  "auth": {
    "method": "auto",
    "oauthClientFile": "tools/import/.secrets/oauth-client.json",
    "tokenFile": "~/.config/gamezero/drive-oauth-token.json",
    "serviceAccountKeyFile": "tools/import/.secrets/service-account.json"
  },
  "rulesFile": "tools/import/mapping-rules.json",
  "output": {
    "rawDir": "imports/drive/raw",
    "stagingDir": "imports/drive/.staging",
    "manifestFile": "imports/drive/manifest.json",
    "manifestCsv": true,
    "writeRaw": true,
    "writeSorted": true,
    "conflictPolicy": "rename"
  },
  "limits": {
    "maxFileSizeMB": 500,
    "concurrency": 4,
    "maxRetries": 6
  },
  "exclude": ["**/.DS_Store", "**/Thumbs.db", "**/desktop.ini", "**/~$*", "**/.~lock.*"],
  "exports": {
    "application/vnd.google-apps.document": [
      {
        "mimeType": "text/markdown",
        "extension": "md",
        "fallbacks": [{ "mimeType": "text/plain", "extension": "txt" }]
      },
      {
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "extension": "docx"
      }
    ],
    "application/vnd.google-apps.spreadsheet": [
      { "mimeType": "text/csv", "extension": "csv", "perSheet": true },
      {
        "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "extension": "xlsx"
      }
    ],
    "application/vnd.google-apps.presentation": [
      { "mimeType": "application/pdf", "extension": "pdf" },
      {
        "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "extension": "pptx"
      }
    ],
    "application/vnd.google-apps.drawing": [
      { "mimeType": "image/png", "extension": "png" },
      { "mimeType": "image/svg+xml", "extension": "svg" }
    ],
    "application/vnd.google-apps.script": [
      { "mimeType": "application/vnd.google-apps.script+json", "extension": "json" }
    ],
    "application/vnd.google-apps.jam": [{ "mimeType": "application/pdf", "extension": "pdf" }]
  }
}
